{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "/usr/bin/bash",
            "args": [
                "-lc",
                "mkdir -p \"${workspaceFolder}/bin\" && /usr/bin/g++ -std=c++17 -g3 -O0 -Wall -Wextra -I \"${workspaceFolder}/include\" \"${workspaceFolder}/src/main.cpp\" \"${workspaceFolder}/src/awgn.cpp\" \"${workspaceFolder}/src/qammod.cpp\" \"${workspaceFolder}/src/qamdemod.cpp\" -o \"${workspaceFolder}/bin/main\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}